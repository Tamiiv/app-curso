@page "/cuenta/restablecer"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<AppUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Restablecer contraseña — Ruta .NET</PageTitle>

<section class="auth-page">
    <div class="auth-card">
        <header class="auth-header">
            <span class="eyebrow">Tu cuenta</span>
            <h1>Restablecer contraseña</h1>
            <p>Elegí una contraseña nueva para tu cuenta.</p>
        </header>

        @if (!HasValidLink)
        {
            <div class="form-alert form-alert-error" role="alert">
                El enlace no es válido o está incompleto. Pedí uno nuevo desde la página de recuperación.
            </div>
            <div class="auth-links">
                <a href="/cuenta/recuperar">Pedir un enlace nuevo</a>
            </div>
        }
        else
        {
            @if (errorMessage is not null)
            {
                <div class="form-alert form-alert-error" role="alert">@errorMessage</div>
            }

            <EditForm Model="Input" method="post" OnValidSubmit="SaveNewPassword" FormName="reset-password">
                <DataAnnotationsValidator />
                <ValidationSummary class="form-alert form-alert-error" role="alert" />
                <input type="hidden" name="Input.Email" value="@Input.Email" />
                <input type="hidden" name="Input.Code" value="@Input.Code" />

                <div class="form-field">
                    <label for="reset-password">Contraseña nueva</label>
                    <InputText @bind-Value="Input.Password" id="reset-password" type="password" autocomplete="new-password" aria-required="true" />
                    <span class="form-hint">Mínimo 8 caracteres.</span>
                    <ValidationMessage For="() => Input.Password" />
                </div>

                <div class="form-field">
                    <label for="reset-confirm">Repetir contraseña</label>
                    <InputText @bind-Value="Input.ConfirmPassword" id="reset-confirm" type="password" autocomplete="new-password" aria-required="true" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>

                <button class="button button-primary button-block" type="submit">Guardar contraseña</button>
            </EditForm>
        }
    </div>
</section>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private bool HasValidLink => !string.IsNullOrWhiteSpace(Input.Email) && !string.IsNullOrWhiteSpace(Input.Code);

    protected override void OnInitialized()
    {
        Input ??= new InputModel();

        if (string.IsNullOrWhiteSpace(Input.Email))
        {
            Input.Email = Email ?? string.Empty;
        }

        if (string.IsNullOrWhiteSpace(Input.Code))
        {
            Input.Code = Code ?? string.Empty;
        }
    }

    private async Task SaveNewPassword()
    {
        errorMessage = null;

        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            errorMessage = "El enlace no es válido o ya venció. Pedí uno nuevo.";
            return;
        }

        string decodedCode;
        try
        {
            decodedCode = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Code));
        }
        catch (FormatException)
        {
            errorMessage = "El enlace no es válido o ya venció. Pedí uno nuevo.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, decodedCode, Input.Password);
        if (!result.Succeeded)
        {
            errorMessage = IdentityErrorTranslator.Translate(result.Errors);
            return;
        }

        RedirectManager.RedirectToWithStatus(
            "/cuenta/ingresar",
            "Contraseña actualizada. Ya podés ingresar con tu contraseña nueva.",
            HttpContext);
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresá una contraseña nueva.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "La contraseña debe tener entre 8 y 100 caracteres.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Las contraseñas no coinciden.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
