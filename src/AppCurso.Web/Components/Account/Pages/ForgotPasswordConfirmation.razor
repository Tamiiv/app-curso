@page "/cuenta/recuperar/confirmacion"

<PageTitle>Revisá tu email — Ruta .NET</PageTitle>

<section class="auth-page">
    <div class="auth-card">
        <header class="auth-header">
            <span class="eyebrow">Tu cuenta</span>
            <h1>Revisá tu email</h1>
            <p>Si el email está registrado, vas a recibir un enlace para restablecer tu contraseña.</p>
        </header>

        <StatusMessage />

        <p class="form-hint">
            El enlace vence después de un tiempo por seguridad. Si no lo ves, revisá la carpeta de spam.
        </p>

        <div class="auth-links">
            <a href="/cuenta/ingresar">Volver a ingresar</a>
        </div>
    </div>
</section>
