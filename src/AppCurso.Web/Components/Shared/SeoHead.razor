@inject NavigationManager Navigation

<HeadContent>
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:type" content="@Type" />
    <meta property="og:site_name" content="Ruta .NET" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
    @if (NoIndex)
    {
        <meta name="robots" content="noindex, follow" />
    }
    @if (!string.IsNullOrWhiteSpace(JsonLd))
    {
        <script type="application/ld+json">@((MarkupString)JsonLd)</script>
    }
</HeadContent>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "Ruta .NET";

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Type { get; set; } = "website";

    [Parameter]
    public string? JsonLd { get; set; }

    [Parameter]
    public bool NoIndex { get; set; }

    private string CanonicalUrl => new Uri(Navigation.Uri).GetLeftPart(UriPartial.Path);
}
